# Copy to .env (git-ignored). The CLI reads it from the current directory.

# --- local mode ---------------------------------------------------------------------------
DLP_POLICY_PATH=config/policies.yaml
DLP_WATCH_DIR=./outbox
DLP_QUARANTINE_DIR=./quarantine
DLP_DB_PATH=./data/incidents.db
# One JSON incident per line, in addition to the SQLite journal:
DLP_LOG_FILE=./data/incidents.jsonl
# Slack, Discord or any JSON endpoint. Treat it as a secret; never commit it.
DLP_WEBHOOK_URL=
# Scan at most this many bytes of each file (default 10 MiB).
DLP_MAX_SCAN_BYTES=10485760

# --- AWS ----------------------------------------------------------------------------------
# Used by `cli.py incident-log query --backend dynamodb` and scripts/seed_test_files.py s3.
# The Lambda function gets its own variables from Terraform (see infra/terraform/lambda.tf).
AWS_DEFAULT_REGION=us-east-1
DLP_TABLE_NAME=dlp-dev-incidents
# LocalStack instead of real AWS:
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
